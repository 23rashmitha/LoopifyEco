{
  "info": {
    "name": "ReLoop Campus REST API Collection",
    "description": "Comprehensive Postman test collection for ReLoop Campus Spring Boot REST APIs (Phase 3 & 4)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login as Alex Chen (Organizer)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex.chen@campus.edu\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "2. Inventory & QR Passport",
      "item": [
        {
          "name": "List Reusable Inventory",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/inventory?search=&category=&condition=&page=0&size=20"
          }
        },
        {
          "name": "Resolve Public QR Token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/inventory/qr/RLP-DISP-001"
          }
        },
        {
          "name": "Register Reusable Item",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Adjustable Aluminum Banner Stands\",\n  \"categoryId\": \"cat-ban\",\n  \"departmentId\": \"dept-sac\",\n  \"storageLocation\": \"Locker 4\",\n  \"totalQuantity\": 6,\n  \"condition\": \"EXCELLENT\"\n}"
            },
            "url": "{{baseUrl}}/inventory"
          }
        }
      ]
    },
    {
      "name": "3. Events & Readiness Innovations",
      "item": [
        {
          "name": "Calculate Event Reuse Readiness Score",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/events/evt-01/readiness"
          }
        },
        {
          "name": "Get Reuse-First Decision Recommendations",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/events/evt-01/reuse-recommendations"
          }
        }
      ]
    },
    {
      "name": "4. Reservations & Concurrency",
      "item": [
        {
          "name": "Submit Reservation Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"evt-01\",\n  \"items\": [\n    {\n      \"inventoryItemId\": \"item-disp-01\",\n      \"quantity\": 6\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/reservations"
          }
        },
        {
          "name": "Approve Reservation (Pessimistic Lock)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reviewerNotes\": \"Approved following date overlap and stock verification.\"\n}"
            },
            "url": "{{baseUrl}}/reservations/res-102/approve"
          }
        }
      ]
    },
    {
      "name": "5. Handover & Return Verification",
      "item": [
        {
          "name": "Record Physical Handover",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantityHandedOver\": 6,\n  \"receivedByUserId\": \"usr-1\",\n  \"initialCondition\": \"GOOD\",\n  \"notes\": \"Clamps and boards verified intact.\"\n}"
            },
            "url": "{{baseUrl}}/reservations/res-101/handover"
          }
        },
        {
          "name": "Verify Return & Log Completed Reuse",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantityReturned\": 6,\n  \"returnCondition\": \"GOOD\",\n  \"isCompleteReturn\": true,\n  \"requiresInspection\": false\n}"
            },
            "url": "{{baseUrl}}/reservations/res-101/return"
          }
        }
      ]
    }
  ]
}
